# Frontend environment (Netlify -> Site configuration -> Environment variables,
# or frontend/.env.local for local dev). These are PUBLIC values baked into the build.

# Backend base URL (with or without /api)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Supabase -> Project Settings -> API. Use the ANON key here, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
