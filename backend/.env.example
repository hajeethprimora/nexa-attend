# ---------------------------------------------------------------
# NexaAttend backend environment (copy to backend/.env for local dev,
# set these in the Render/Railway dashboard for production)
# ---------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Exact URL(s) of the deployed frontend, comma-separated. Required in production (CORS).
# Netlify deploy previews can be allowed with a wildcard: https://*--softnixattend.netlify.app
FRONTEND_URL=https://softnixattend.netlify.app

# Supabase (Project Settings -> API). The service role key is SECRET: backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Company policy ----
COMPANY_NAME=Softnix
# IANA timezone used for "today", late arrival and monthly reports
APP_TIMEZONE=Asia/Kolkata
# Hours after which time counts as overtime (per day, all sessions combined)
STANDARD_WORKDAY_HOURS=8
# Minutes after shift start before someone is marked late
LATE_GRACE_MINUTES=10
# Sessions left open longer than this are auto-closed at shift end and flagged for review
MAX_SESSION_HOURS=16
# Weekend days excluded from leave/absence counts (0=Sun ... 6=Sat)
WEEKEND_DAYS=0,6

# ---- Accounts ----
# Leave false so only admins can create accounts. If true, restrict to your domain(s).
ALLOW_PUBLIC_SIGNUP=false
ALLOWED_EMAIL_DOMAINS=softnix.com

# ---- Email (optional; without SMTP, emails are only logged) ----
# Comma-separated addresses that receive new leave request alerts
ADMIN_EMAIL=hr@softnix.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Softnix Attend <noreply@softnix.com>"
