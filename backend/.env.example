# NexaAttend Backend Environment Configuration Template
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Transactional Email SMTP Configuration (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
EMAIL_FROM_NAME="NexaAttend HR"
EMAIL_FROM_ADDRESS=noreply@nexaattend.com
